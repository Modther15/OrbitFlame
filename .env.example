# OrbitFlame configuration. Every variable is OPTIONAL: with no .env file the app runs fully
# on the NASA PSI snapshots committed in public/data (npm install && npm run dev).
# Copy this file to .env to change anything. .env is gitignored; never commit keys.

# --- Optional external backend ------------------------------------------------------------
# Leave empty to use the app's own built-in /api routes (recommended). Set to the URL of the
# optional Python backend (same routes, e.g. http://localhost:8000) to prefer it. It is tried
# first with a 2.5 s timeout and the app falls back to the built-in API when it is unreachable.
# NEXT_PUBLIC_ variables are baked in at build time: restart `npm run dev` (or rebuild) after changing it.
NEXT_PUBLIC_API_BASE=

# Server-side URL of the external backend's /api/assistant, only used if it differs from NEXT_PUBLIC_API_BASE.
FASTAPI_URL=

# Legacy browser client (src/lib/api/client.ts). Not used by any current page. Leave empty.
NEXT_PUBLIC_API_BASE_URL=

# --- Legacy demo fixtures -----------------------------------------------------------------
# Set to "true" to swap the NASA PSI data for 12 clearly labelled FICTIONAL demo records
# (src/lib/demo/dataset.ts), for UI testing only. Default (false) always uses real PSI data.
DEMO_MODE=false

# --- AI Assistant (optional) --------------------------------------------------------------
# Without a key the assistant still answers from the PSI records with row-level citations
# (deterministic mode). With a key it also writes an AI summary over the retrieved evidence.
OPENAI_API_KEY=
# Allowed: gpt-4o-mini (default), gpt-4.1-nano, gpt-4.1-mini, gpt-6-luna. Anything else falls back to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Local soft spend cap in USD, tracked in .openai_spend.json (gitignored). Also set a hard limit in the OpenAI dashboard.
OPENAI_BUDGET_USD=1
# Per-1M-token prices used by the local cap for gpt-6-luna (defaults are conservative guesses).
# OPENAI_PRICE_IN_PER_M=
# OPENAI_PRICE_OUT_PER_M=
