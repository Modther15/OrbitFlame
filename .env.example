# FlameGuard SI backend (FastAPI). The UI tries this first (2.5 s timeout) and
# automatically falls back to the static snapshots in public/data/*.json.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Legacy client-side URL used by src/lib/api/client.ts (optional)
NEXT_PUBLIC_API_BASE_URL=
# Set to "true" to force the legacy fictional demo fixtures instead of backend/snapshot data.
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local soft spend cap (USD) tracked in .openai_spend.json; also set a hard limit in the OpenAI dashboard.
OPENAI_BUDGET_USD=1
# Real per-1M-token prices for gpt-6-luna (used by the local $ cap). Defaults are conservative guesses.
# OPENAI_PRICE_IN_PER_M=
# OPENAI_PRICE_OUT_PER_M=
